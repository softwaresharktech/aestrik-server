# ============================================================
# Asterisk / FreePBX — Production Configuration Reference (DataHub)
#
# FreePBX itself does NOT read a dotenv file — its config lives in its own MariaDB database
# plus /etc/asterisk/*.conf. But scripts/bootstrap-datahub-server.sh DOES read a filled-in
# copy of this file automatically (as .env.production at the repo root) — copy this file to
# .env.production, fill in real values, and the bootstrap script picks it up with no extra
# flags. It's also the canonical list of values used in two other places:
#   1. scripts/configure-external-db.sql and the FreePBX GUI (trunks)
#   2. GitHub repo secrets (Settings -> Secrets and variables -> Actions)
#
# NEVER commit a filled-in copy — .env.production is already in .gitignore.
# See documentation/09-datahub-production-deployment.md.
# ============================================================

# --- Network (documentation/01-server-provisioning.md) ---
ERP_BACKEND_IP=<private-ip-of-the-lamaerp-backend>       # the only host allowed to reach AMI/ARI
ADMIN_SSH_CIDR=<your-admin-ip>/32                          # never 0.0.0.0/0
TRUNK_PROVIDER_CIDR=<sip-trunk-providers-signaling-cidr>    # tighten once known; see scripts/bootstrap-datahub-server.sh

# --- Separate MariaDB service (documentation/09, Step 1 — NOT a container next to Asterisk) ---
DB_HOST=<datahub-mariadb-private-ip>
DB_PORT=3306
DB_NAME=asterisk
DB_USER=freepbxuser
DB_PASS=<strong-random-password>          # created via scripts/configure-external-db.sql
# Read-only-enough user for nightly backups (documentation/09, backup-freepbx-db.yml).
# Reusing DB_USER/DB_PASS above works too if a separate backup user isn't worth the extra step yet.
DB_BACKUP_USER=<backup-only-db-user-or-reuse-freepbxuser>
DB_BACKUP_PASS=<strong-random-password>

# --- AMI (documentation/04-asterisk-apis-ami-ari.md) ---
# Generated by scripts/bootstrap-datahub-server.sh — copy its printed value here, and into
# the LamaERP backend's own secrets store as ITelephonyDispatcher's AMI credential.
AMI_USER=lamaerp
AMI_SECRET=<printed-by-bootstrap-script>

# --- ARI ---
ARI_USER=lamaerp
ARI_SECRET=<printed-by-bootstrap-script>

# --- SIP trunk (documentation/03-freepbx-configuration.md — provider TBD) ---
SIP_TRUNK_HOST=<itsp-sip-host>
SIP_TRUNK_USER=<itsp-account-id>
SIP_TRUNK_PASS=<itsp-account-secret>

# --- GitHub repo secrets this project's CI/CD actually reads (documentation/09, Step 4) ---
# DEPLOY_HOST        = this Asterisk server's address
# DEPLOY_USER         = SSH user for both deploy workflows
# DEPLOY_SSH_KEY      = private key for DEPLOY_USER
# DB_HOST             = same value as above
# DB_BACKUP_USER      = same value as above
# DB_BACKUP_PASS      = same value as above
